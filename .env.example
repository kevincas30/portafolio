# URL pública final, sin barra al final (opcional hasta publicar)
PUBLIC_SITE_URL=

# Adaptador de formulario: "webhook" o "disabled"
CONTACT_PROVIDER=disabled
# Endpoint de tu proveedor/automatización. Solo se usa en servidor.
CONTACT_WEBHOOK_URL=
# Token Bearer opcional. Solo se usa en servidor.
CONTACT_WEBHOOK_TOKEN=

# Datos públicos reales. Si quedan vacíos, no se muestran.
PUBLIC_CONTACT_EMAIL=
PUBLIC_WHATSAPP_URL=

# Panel privado de clientes (/admin). Base de datos Turso.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Passkeys (WebAuthn) del panel. Solo se usan en servidor.
# Dominio sin protocolo ni www. Local: localhost. Producción: discreativo.com
# Ojo: los passkeys quedan atados a este valor; si cambia, hay que registrarlos de nuevo.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Panel Diseño Creativo
# Orígenes permitidos con protocolo (y puerto en local), separados por coma.
# Producción: https://www.discreativo.com,https://discreativo.com
WEBAUTHN_ORIGINS=http://localhost:4321