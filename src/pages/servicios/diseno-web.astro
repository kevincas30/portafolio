---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Accordion from '../../components/Accordion.astro';
import ContactBlock from '../../components/ContactBlock.astro';
const projects = (await getCollection('projects')).filter(p => p.data.category === 'Web').sort((a,b) => a.data.order - b.data.order);
const faq = [
  { question: '¿Necesito tener los textos y las fotos?', answer: 'No necesariamente. Podemos ayudarte a ordenar y trabajar los textos, definir qué imágenes hacen falta o diseñar una solución que funcione con el material disponible. Se concreta en cada propuesta.' },
  { question: '¿Podré actualizar la web?', answer: 'La construimos para que el contenido previsto como editable pueda mantenerse sin rehacer el diseño. El sistema concreto depende de la frecuencia y el tipo de actualización.' },
  { question: '¿Incluye dominio y alojamiento?', answer: 'Podemos ayudarte a elegirlos y configurarlos, pero sus costes y condiciones dependen del proveedor y no se presuponen incluidos en todos los proyectos.' },
  { question: '¿Cuánto tarda un proyecto?', answer: 'Depende del número de páginas, el material disponible, las funcionalidades y los tiempos de revisión. Tras conocer el alcance proponemos un calendario realista.' },
  { question: '¿Qué ocurre después de publicarla?', answer: 'Acordamos la entrega, documentación y, si hace falta, un plan separado de soporte o mejoras. No damos por incluida una permanencia indefinida.' },
];
const features = ['Estructura y contenido', 'Diseño visual', 'Experiencia en móvil', 'Desarrollo', 'Formulario y vías de contacto', 'Preparación para publicación'];
const types = ['Landing pages', 'Webs corporativas', 'Restaurantes y hoteles', 'Portfolios', 'Catálogos', 'Funcionalidades específicas'];
---
<BaseLayout title="Diseño y desarrollo web" description="Diseñamos y desarrollamos webs que explican bien un negocio y hacen fácil dar el siguiente paso.">
  <section class="section"><div class="container hero-grid"><div><span class="eyebrow">Diseño + desarrollo web</span><h1 class="page-title">Tu web, desde la idea hasta el último detalle.</h1><p class="lead">Diseñamos y desarrollamos páginas que explican bien tu negocio y hacen fácil dar el siguiente paso.</p><a class="button button--lime" href="/contacto?servicio=web">Hablemos de tu web <span>→</span></a></div><BrowserFrame src="/proyectos/La%20rueca/la-rueca-desktop.webp" alt="Web de Alojamiento La Rueca en escritorio" /></div></section>
  <section class="section section--dark"><div class="container"><SectionHeading number="01" title="De la estructura a una web que puedes usar." /><div class="feature-grid">{features.map((item, i) => <article class="feature"><b>0{i+1}</b><h3>{item}</h3><p>{i === 0 ? 'Definimos qué contar, en qué orden y con qué profundidad.' : i === 1 ? 'Creamos un lenguaje visual propio y consistente.' : i === 2 ? 'Diseñamos la experiencia pequeña primero, no como una adaptación tardía.' : i === 3 ? 'Construimos con una base rápida, accesible y fácil de mantener.' : i === 4 ? 'Preparamos rutas claras para escribir o pedir información. Las reservas automáticas requieren un alcance específico.' : 'Revisamos contenido y la preparación básica para buscadores antes de entregar.'}</p></article>)}</div></div></section>
  <section class="section"><div class="container"><SectionHeading number="02" title="Idea → wireframe → diseño → código → web." /><div class="timeline" data-reveal>{['Idea', 'Wireframe', 'Diseño', 'Código', 'Web'].map((step, i) => <article class="timeline-step"><b>0{i+1}</b><h3>{step}</h3><p>{['Objetivos, contenido y prioridades.','La estructura antes del acabado.','Tipografía, color, ritmo e interacción.','Una implementación fiel y mantenible.','Pruebas, entrega y publicación acordada.'][i]}</p></article>)}</div><div style="margin-top:3rem"><BrowserFrame src="/proyectos/Italy%20pizza/italy-pizza-desktop.webp" alt="Web publicada de Italy Pizza en escritorio" /></div></div></section>
  <section class="section section--tight"><div class="container"><SectionHeading number="Encaja en" title="Distintos tamaños, un alcance concreto." /><div class="deliverables">{types.map(type => <div class="deliverable">{type}</div>)}</div><p class="lead">Las funcionalidades se definen y presupuestan según el proyecto. Un catálogo, una reserva o una integración específica no se consideran incluidos de forma automática.</p></div></section>
  <section class="section"><div class="container"><SectionHeading number="03" title="Proyectos relacionados." /><div class="project-list">{projects.map(project => <ProjectCard project={project} />)}</div></div></section>
  <section class="section"><div class="narrow"><SectionHeading number="FAQ" title="Preguntas sobre tu web." /><Accordion items={faq} /></div></section>
  <ContactBlock />
</BaseLayout>
