---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Accordion from '../../components/Accordion.astro';
import ContactBlock from '../../components/ContactBlock.astro';
const formats = ['Posts', 'Historias', 'Carruseles', 'Flyers', 'Reels y edición de vídeo'];
const faq = [
  { question: '¿También publicáis y gestionáis las cuentas?', answer: 'No de forma automática. Nuestro servicio base cubre diseño y entrega. La publicación, planificación, moderación o respuesta de mensajes se puede valorar aparte si se necesita.' },
  { question: '¿Necesito una identidad de marca?', answer: 'Ayuda, pero no siempre es imprescindible. Podemos trabajar desde tu identidad actual o definir un pequeño sistema visual específico para el contenido.' },
  { question: '¿Puedo pedir una pieza puntual?', answer: 'Sí. También podemos plantear una colaboración recurrente cuando hay una cantidad estable de contenido y un calendario claro.' },
];
---
<BaseLayout title="Diseño para redes" description="Posts, historias, carruseles, flyers y reels con una presencia visual coherente.">
  <section class="section"><div class="container"><span class="eyebrow">Contenido visual</span><h1 class="page-title">Contenido que se reconoce como tuyo.</h1><p class="lead">Diseñamos piezas para que tu marca tenga una presencia coherente, desde una historia hasta un carrusel o un vídeo.</p><a class="button button--lime" href="/contacto?servicio=redes">Cuéntanos qué piezas necesitas <span>→</span></a></div></section>
  <section class="section section--dark"><div class="container"><SectionHeading number="01" title="Cada formato cumple una función." /><div class="feature-grid">{formats.map((format, i) => <article class="feature"><b>0{i+1}</b><h3>{format}</h3><p>{['Una idea clara en una composición que funciona en el feed.','Información rápida y vertical, pensada para verse sin esfuerzo.','Un argumento dividido en pantallas con ritmo y continuidad.','Piezas para comunicar una fecha, producto o evento concreto.','Guion visual, edición, títulos y entrega en el formato acordado.'][i]}</p></article>)}</div></div></section>
  <section class="section"><div class="container"><SectionHeading number="02" title="Del material a una familia de piezas." intro="Adaptamos la identidad, organizamos la información, elegimos el formato y preparamos los archivos para su uso." /><p class="lead">Trabajamos con fotografías, vídeo, textos e identidad facilitados por la marca, o acordamos qué material hay que producir. La entrega puede ser puntual o recurrente.</p></div></section>
  <section class="section"><div class="narrow"><SectionHeading number="FAQ" title="Antes de diseñar las piezas." /><Accordion items={faq} /></div></section>
  <ContactBlock />
</BaseLayout>
