---
import NichePage from '../components/NichePage.astro';
import BrowserFrame from '../components/BrowserFrame.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import { site } from '../config/site';
const pack = site.packs[0];
---
<NichePage
  pack={pack}
  metaTitle="Web esencial para restaurantes"
  metaDescription="Presenta tu restaurante, tu carta, horarios, ubicación y contacto. Pedidos preparados por WhatsApp si ofreces comida para llevar o reparto."
  animatedHero
  readingProblem
  singlePrice
  compactContactTitle="Una demo para tu restaurante."
  title="Tu carta, tu espacio y cómo encontrarte."
  lead="Una web para presentar tu restaurante, consultar la carta desde el móvil y encontrar tus horarios, ubicación y contacto. Si recibes pedidos para llevar o reparto, también podemos prepararlos por WhatsApp."
  problem="Antes de visitarte, la gente quiere ver la carta, conocer tu espacio, saber cuándo abres y cómo llegar. Reúne todo en una web fácil de consultar."
  benefits={[
    ['Carta siempre a mano', 'Platos, precios y alérgenos fáciles de consultar desde el móvil o un código QR.'],
    ['Pedidos si los necesitas', 'Para llevar o reparto, el cliente puede preparar un mensaje con productos y total para enviarlo a tu WhatsApp.'],
    ['Tú controlas la carta', 'Cambias platos, precios o agotados desde una hoja de Google, sin llamarnos.'],
    ['Visítanos sin dudas', 'Horarios, ubicación e información del local en un mismo sitio.'],
    ['Contacto para consultar una mesa', 'Un acceso a WhatsApp permite escribir al restaurante. Un sistema automático de reservas se presupuesta aparte.'],
    ['Tu identidad', 'Tu nombre, tus imágenes y tu propio dominio en una web para tu restaurante.'],
  ]}
  projectSlugs={['italy-pizza', 'el-tiburon-de-la-costa']}
  faq={[
    { question: '¿Sirve si no hago reparto?', answer: 'Sí. La carta, los horarios, la ubicación y el contacto sirven también para un restaurante que solo atiende en el local.' },
    { question: '¿Qué hace el pedido por WhatsApp?', answer: 'Si ofreces pedidos para llevar o reparto, el cliente prepara un mensaje con los productos y el total y lo envía a tu WhatsApp. La confirmación y el cobro los gestionas tú; la web no los automatiza.' },
    { question: '¿Puedo recibir reservas de mesas?', answer: 'La web puede mostrar un acceso para consultarte una mesa por WhatsApp. Un sistema automático de reservas con disponibilidad o confirmaciones se presupuesta aparte.' },
    { question: '¿Y si cambio un precio o se me acaba un plato?', answer: 'Lo cambias en una hoja de Google, como una lista normal, y la carta se actualiza sola.' },
    { question: '¿Qué necesito para empezar?', answer: 'Cuéntanos cómo es tu restaurante y pásanos tu carta, tu web o algunas fotos. Con ese material preparamos una muestra visual inicial, sin compromiso.' },
    { question: '¿Qué incluyen los 15 € al mes?', answer: site.monthlyIncludes },
  ]}
>
  <div slot="visual" class="desk-composition niche-visual restaurant-visual" data-hero-composition aria-label="Web de Italy Pizza en ordenador y móvil">
    <div class="hero-entry"><div class="hero-float"><BrowserFrame class="hero-browser" src="/proyectos/Italy%20pizza/italy-pizza-desktop.webp" alt="Web de Italy Pizza en ordenador" /></div></div>
    <div class="hero-entry"><div class="hero-float"><PhoneFrame class="hero-phone" src="/proyectos/Italy%20pizza/italy-pizza-mobile.webp" alt="Carta de Italy Pizza en el móvil" /></div></div>
    <div class="hero-entry"><div class="hero-float"><div class="hero-note">italypizza.es<br/>proyecto real ↘</div></div></div>
  </div>
</NichePage>
