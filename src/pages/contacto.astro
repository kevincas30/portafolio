---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { site, waLink, redesWhatsAppText } from '../config/site';
export const prerender = false;
const isRedes = Astro.url.searchParams.get('servicio') === 'redes';
const contactTitle = isRedes ? 'Pide presupuesto de contenido.' : 'Pide tu demo gratis.';
const contactDescription = isRedes
  ? 'Cuéntanos qué negocio tienes y qué contenido necesitas para redes. Te proponemos un alcance y un presupuesto.'
  : 'Cuéntanos qué negocio tienes y envíanos tu web, carta o algunas fotos por WhatsApp. Preparamos una muestra visual inicial antes de contratar.';
const whatsappHref = isRedes ? waLink(redesWhatsAppText) : site.whatsapp;
const ctaLabel = isRedes ? 'Pedir presupuesto de contenido' : 'Escribir por WhatsApp';
const mailHref = `mailto:${site.email}${isRedes ? '?subject=Consulta%20de%20contenido%20para%20redes' : ''}`;
const telHref = `tel:${site.whatsappDisplay.replace(/\s+/g, '')}`;
---
<BaseLayout title={isRedes ? 'Contacto para contenido de redes' : 'Contacto'} description={contactDescription}>
  <section class="section section--contact-hero"><div class="container"><span class="eyebrow">Contacto</span><h1 class="page-title">{contactTitle}</h1><p class="lead">{contactDescription}</p></div></section>
  <section class="section--tight section--contact-card"><div class="container contact-card"><div><h2>{isRedes ? 'Hablemos de tus piezas.' : 'Un mensaje es suficiente.'}</h2><p>{isRedes ? 'Indícanos qué formatos buscas y si tienes material o identidad visual.' : 'Cuéntanos qué necesitas y te respondemos en menos de 48 h.'}</p></div><div class="contact-actions contact-actions--main"><div class="contact-detail"><span class="contact-detail-label">Teléfono</span><a class="contact-detail-link" href={telHref}>{site.whatsappDisplay} <span aria-hidden="true">↗</span></a></div><div class="contact-divider" role="presentation"></div><div class="contact-detail"><span class="contact-detail-label">Email</span><a class="contact-detail-link" href={mailHref}>{site.email} <span aria-hidden="true">↗</span></a></div><div class="contact-divider" role="presentation"></div><a class="button contact-cta" href={whatsappHref} target="_blank" rel="noopener noreferrer">{ctaLabel} <span aria-hidden="true">↗</span></a><ContactForm compact={false} /></div></div></section>
  <section class="section--tight"><div class="narrow"><p><strong>Qué ocurre con tus datos:</strong> se utilizan únicamente para responder a tu consulta según lo descrito en el borrador de privacidad. No se guardan en esta web por defecto.</p></div></section>
  <script>
    const preselect = () => { const query = new URLSearchParams(location.search).get('servicio'); const select = document.querySelector<HTMLSelectElement>('select[name="service"]'); if (!select || !query) return; if (query === 'web') select.value = 'Diseño y desarrollo web'; if (query === 'redes') select.value = 'Diseño para redes'; };
    preselect(); document.addEventListener('astro:page-load', preselect);
  </script>
</BaseLayout>
