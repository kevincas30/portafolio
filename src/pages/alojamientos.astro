---
import NichePage from '../components/NichePage.astro';
import BrowserFrame from '../components/BrowserFrame.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import { site } from '../config/site';
const pack = site.packs[1];
---
<NichePage
  pack={pack}
  metaTitle="Web esencial para hoteles"
  metaDescription="Presenta las habitaciones, instalaciones y servicios de tu hotel con galería, ubicación, información práctica y contacto directo."
  animatedHero
  readingProblem
  singlePrice
  compactContactTitle="Una demo para tu hotel."
  title="Una web que muestre tu hotel y facilite el contacto directo."
  lead="Presenta tus habitaciones, instalaciones y servicios. Ayuda a tus huéspedes a encontrar la información que necesitan y a consultarte disponibilidad por WhatsApp o email."
  problem="Quien está pensando en alojarse quiere conocer las habitaciones, los servicios, la ubicación y las condiciones prácticas antes de escribirte. Tu web puede reunirlo con la identidad de tu hotel."
  benefits={[
    ['Habitaciones y estancias', 'Presenta los tipos de habitación y la información que necesita quien prepara su estancia.'],
    ['Instalaciones y servicios', 'Explica qué ofrece el hotel y muestra sus espacios en una galería cómoda para móvil.'],
    ['Ubicación clara', 'Mapa y datos prácticos para saber dónde está el hotel y cómo llegar.'],
    ['Contacto directo', 'Un acceso para consultar disponibilidad por WhatsApp o email; la respuesta la da tu equipo.'],
    ['Tu identidad', 'Tus imágenes, colores y dominio para que la web se reconozca como la de tu hotel.'],
    ['Preparada para buscadores', 'Títulos, descripciones y sitemap básicos, sin prometer posiciones en los resultados.'],
  ]}
  projectSlugs={['alojamiento-la-rueca']}
  faq={[
    { question: '¿Qué tipos de hotel pueden usar este pack?', answer: 'Hoteles de distintos tamaños pueden presentar sus habitaciones, instalaciones e información práctica. El pack mantiene un alcance de hasta cinco secciones; si necesitas más, lo presupuestamos aparte.' },
    { question: '¿Incluye un motor de reservas?', answer: 'No. Incluye contacto directo por WhatsApp o email para consultar disponibilidad. Un motor de reservas, pagos online o conexión con tu sistema actual se presupuestan aparte.' },
    { question: '¿Puede estar en inglés?', answer: 'Sí. La versión en otros idiomas se presupuesta aparte según el número de secciones.' },
    { question: '¿Qué necesito para empezar?', answer: 'Información sobre habitaciones, servicios y ubicación, además de tu web o algunas fotos. Con eso preparamos una muestra visual inicial; después concretamos el contenido necesario.' },
    { question: '¿Qué incluyen los 15 € al mes?', answer: site.monthlyIncludes },
  ]}
>
  <div slot="visual" class="desk-composition niche-visual niche-motion-visual" data-hero-composition aria-label="Web de Alojamiento La Rueca en ordenador y móvil">
    <div class="hero-entry"><div class="hero-float"><BrowserFrame class="hero-browser" src="/proyectos/La%20rueca/la-rueca-desktop.webp" alt="Web de Alojamiento La Rueca en ordenador" /></div></div>
    <div class="hero-entry"><div class="hero-float"><PhoneFrame class="hero-phone" src="/proyectos/La%20rueca/la-rueca-mobile.webp" alt="Web de Alojamiento La Rueca en el móvil" /></div></div>
    <div class="hero-entry"><div class="hero-float"><div class="hero-note">La Rueca<br/>proyecto real ↘</div></div></div>
  </div>
</NichePage>
