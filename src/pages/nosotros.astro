---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TeamMember from '../components/TeamMember.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { site, teamWhatsAppText } from '../config/site';

const services = [
  { title: 'Una web que lo ponga fácil.', text: 'Presenta lo que ofreces y ayuda a tus clientes a encontrar la información y dar el siguiente paso.' },
  { title: 'Diseño para que te reconozcan.', text: 'Piezas para redes que mantienen tu identidad y comunican con claridad lo que quieres contar.' },
  { title: 'Fotos que muestran lo tuyo.', text: 'Imágenes de tus productos, espacios y detalles para que el cliente sepa qué puede esperar.' },
];
---
<BaseLayout title="Conoce al equipo" description="Conoce a Kevs, Gabriel y Mar: diseño web y para redes, desarrollo web y fotografía para presentar tu negocio con una imagen coherente.">
  <section class="section section--tight section--dark"><div class="container">
    <span class="eyebrow">El estudio</span>
    <h1 class="page-title">Tres personas. Un proyecto en común.</h1>
    <p class="lead">Somos Kevs, Gabriel y Mar. Juntamos diseño, desarrollo web y fotografía para que tu negocio tenga una imagen cuidada, una web fácil de usar y contenido que se reconozca como tuyo.</p>
    <p class="team-story">Diseño Creativo empezó con Mar y Kevs en México. Cuando Kevs se mudó a España, conoció a Gabriel, que se sumó al equipo con el desarrollo web. Así fuimos reuniendo lo que cada uno sabe hacer para trabajar juntos.</p>
  </div></section>

  <section class="section section--tight section--dark"><div class="container">
    <SectionHeading title="Con quién vas a trabajar." />
    <div class="team-grid">
      {site.team.map((member) => <TeamMember {...member} />)}
    </div>
  </div></section>

  <section class="section section--tight section--dark"><div class="container">
    <SectionHeading title="Tu web, tus imágenes y tu contenido. Con una misma intención." intro="Puedes contar con nosotros para una parte del proyecto o combinar los tres servicios. Trabajamos juntos para que las fotos, la web y las piezas de redes se sientan parte del mismo negocio." />
    <div class="feature-grid">
      {services.map((item) => <article class="feature"><h3>{item.title}</h3><p>{item.text}</p></article>)}
    </div>
    <p class="services-note">Hablas directamente con el equipo. Te mostramos avances y explicamos las decisiones con palabras claras.</p>
  </div></section>

  <ContactBlock
    title="Cuéntanos qué tienes en mente."
    description="Una web, contenido para redes, fotografías para tu negocio o todo junto. Escríbenos y vemos qué necesitas y cómo podemos ayudarte."
    buttonLabel="Hablar de mi proyecto"
    waText={teamWhatsAppText}
  />
</BaseLayout>
