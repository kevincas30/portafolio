---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { site } from '../config/site';
const values = [
  ['Hablas con quienes hacen el trabajo.', 'La comunicación y las decisiones no pasan por capas innecesarias.'],
  ['Compartimos avances para decidir contigo.', 'Mostramos el trabajo en puntos claros, con contexto y preguntas concretas.'],
  ['Cada pieza tiene una razón.', 'Una decisión visual debe ayudar a leer, reconocer, navegar o entender.'],
  ['Cuidamos cómo se ve y cómo funciona.', 'Diseño y desarrollo avanzan juntos desde el principio.'],
];
---
<BaseLayout title="Nosotros" description="Un estudio independiente de diseño y desarrollo web para restaurantes y alojamientos de toda España.">
  <section class="section"><div class="container"><span class="eyebrow">El estudio</span><h1 class="page-title">Diseño y desarrollo, trabajando juntos.</h1><p class="lead">Unimos la parte visual y la parte técnica para que una idea llegue a convertirse en algo que puedas utilizar.</p></div></section>
  <section class="section section--dark"><div class="container case-copy-grid"><div data-reveal><span class="eyebrow">Cómo trabajamos</span><h2 class="section-title">Una mesa compartida, sin importar la distancia.</h2></div><div data-reveal><p class="lead">Diseño Creativo es un estudio independiente. Trabajamos en remoto con restaurantes, alojamientos y negocios de toda España. El proceso se apoya en conversaciones directas, entregas comprensibles y decisiones que quedan documentadas.</p><p class="lead">No inventamos una oficina ni un equipo que no existe. La configuración admite añadir perfiles reales cuando corresponda.</p></div></div></section>
  <section class="section"><div class="container"><SectionHeading number="01" title="Criterios que se convierten en acciones." /><div class="feature-grid">{values.map((item, i) => <article class="feature"><b>0{i+1}</b><h3>{item[0]}</h3><p>{item[1]}</p></article>)}</div></div></section>
  <section class="section section--tight"><div class="container"><SectionHeading number="02" title="En remoto, pero cerca." intro="Trabajar a distancia no significa trabajar lejos de ti: hablas directamente con quienes hacen tu web, por WhatsApp o videollamada." /><div class="timeline"><article class="timeline-step"><b>01</b><h3>Contexto</h3><p>Entendemos la marca, el lugar y a quién necesita hablarle.</p></article><article class="timeline-step"><b>02</b><h3>Ritmo</h3><p>Revisiones cortas por WhatsApp, cuando a ti te viene bien.</p></article><article class="timeline-step"><b>03</b><h3>Claridad</h3><p>Centralizamos decisiones, archivos y siguientes pasos.</p></article></div></div></section>
  {site.team.length > 0 && <section class="section"><div class="container"><SectionHeading number="03" title="Equipo" /><div class="feature-grid">{site.team.map(member => <article class="feature"><h3>{member.name}</h3><p>{member.role}</p>{member.bio && <p>{member.bio}</p>}</article>)}</div></div></section>}
  <ContactBlock />
</BaseLayout>
