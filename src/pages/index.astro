---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BrowserFrame from '../components/BrowserFrame.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PricingCards from '../components/PricingCards.astro';
import Accordion from '../components/Accordion.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { site, waLink } from '../config/site';
const projects = (await getCollection('projects')).filter((p) => !p.data.isDemo).sort((a,b) => a.data.order - b.data.order);
const [restaurantes, alojamientos] = site.packs;
const steps = [
  ['Nos escribes por WhatsApp.', 'Nos dices el nombre de tu negocio y qué necesitas. Dos minutos.'],
  ['Te preparamos una demo gratis.', 'Con tu carta o tus fotos reales, para que la veas en tu propio móvil.'],
  ['Si te gusta, empezamos.', 'Pagas el 50% y nos pasas el material que tengas. Si falta algo, te ayudamos.'],
  ['Revisamos contigo.', 'Ajustamos textos, fotos y detalles hasta que esté como quieres.'],
  ['La publicamos.', 'Pagas el 50% restante y tu web queda online con tu propio dominio.'],
];
const faq = [
  { question: '¿Tengo que dejar Glovo, Just Eat o Booking?', answer: 'No. Tu web es un canal más, pero sin comisión. Muchos clientes que ya te conocen prefieren pedir o reservar directamente si se lo pones fácil.' },
  { question: '¿Puedo cambiar precios y platos yo mismo?', answer: 'Sí. En el pack de restaurantes la carta se edita desde una hoja de Google, como una lista normal. Y los cambios pequeños que nos pidas entran en la cuota mensual.' },
  { question: '¿Qué incluyen los 15 € al mes?', answer: `${site.monthlyIncludes}` },
  { question: '¿Cuánto tarda?', answer: `${restaurantes.delivery} el pack de restaurantes y ${alojamientos.delivery.toLowerCase()} el de alojamientos, contando desde que tenemos tu material.` },
  { question: '¿Cómo se paga?', answer: 'El 50% al empezar y el 50% al publicar, por Bizum o transferencia. La demo es gratis y no te compromete a nada.' },
  { question: '¿No tengo fotos ni textos, puedo igual?', answer: 'Sí. Te ayudamos a escribir los textos y a elegir las fotos. Con las de tu móvil, bien hechas, suele ser suficiente para empezar.' },
  { question: '¿Trabajáis fuera de mi ciudad?', answer: 'Sí, en toda España. Trabajamos en remoto, por WhatsApp y videollamada.' },
];
---
<BaseLayout title="Diseño Creativo" description={site.description}>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1 class="display">Más pedidos. Cero comisiones.</h1>
        <p class="lead">Webs para <strong>restaurantes</strong> y <strong>alojamientos rurales</strong>: tu carta online con pedidos por WhatsApp, o tu casa con reservas directas. Sin pagar a una plataforma por cada cliente.</p>
        <div class="button-row"><a class="button button--lime" href={site.whatsapp} target="_blank" rel="noopener noreferrer">Pide tu demo gratis <span>↗</span></a><a class="arrow-link" href="/proyectos">Ver proyectos reales <span>→</span></a></div>
        <div class="niche-pills"><a class="niche-pill" href="/restaurantes">Tengo un restaurante <span>→</span></a><a class="niche-pill" href="/alojamientos">Tengo un alojamiento <span>→</span></a></div>
        <p class="hero-meta">{site.area}</p>
      </div>
      <div class="desk-composition" aria-label="Webs reales: Alojamiento La Rueca en escritorio e Italy Pizza en el móvil">
        <BrowserFrame class="hero-browser" src="/proyectos/la-rueca-desktop.webp" alt="Web de Alojamiento La Rueca en escritorio" />
        <PhoneFrame class="hero-phone" src="/proyectos/italy-pizza-mobile.webp" alt="Carta online de Italy Pizza en el móvil" />
        <div class="hero-note">proyectos reales,<br/>publicados y en uso ↘</div>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="narrow" data-reveal><span class="eyebrow">El problema</span><p class="intro-statement">Las plataformas cobran por cada pedido y cada reserva. <em>Una web propia, no:</em> el cliente es tuyo y el margen también.</p></div>
  </section>

  <section class="section"><div class="container"><SectionHeading number="01" title="Dos packs. Un precio claro." intro="Pensados para negocios que viven de sus clientes y no tienen tiempo para webs complicadas." /></div>
    <div class="services-split">
      <article class="service-panel">
        <div class="service-copy"><div><span class="label">{restaurantes.label}</span><h3>{restaurantes.title}</h3><p>{restaurantes.pitch}</p></div><div class="button-row"><a class="button button--lime" href={waLink(restaurantes.waText)} target="_blank" rel="noopener noreferrer">Quiero mi demo <span>↗</span></a><a class="arrow-link" href={restaurantes.href}>Ver el pack <span>→</span></a></div></div>
        <div class="service-visual"><PhoneFrame class="service-phone" src="/proyectos/italy-pizza-mobile.webp" alt="Carta online de Italy Pizza en el móvil" /></div>
      </article>
      <article class="service-panel">
        <div class="service-copy"><div><span class="label">{alojamientos.label}</span><h3>{alojamientos.title}</h3><p>{alojamientos.pitch}</p></div><div class="button-row"><a class="button button--lime" href={waLink(alojamientos.waText)} target="_blank" rel="noopener noreferrer">Quiero mi demo <span>↗</span></a><a class="arrow-link" href={alojamientos.href}>Ver el pack <span>→</span></a></div></div>
        <div class="service-visual"><BrowserFrame src="/proyectos/la-rueca-desktop.webp" alt="Web de Alojamiento La Rueca en escritorio" /></div>
      </article>
    </div>
    <div class="container"><p class="extra-service">¿También necesitas posts, historias o flyers? <a class="arrow-link" href="/servicios/diseno-para-redes">Diseñamos tu contenido para redes <span>→</span></a></p></div>
  </section>

  <section class="section"><div class="container"><SectionHeading number="02" title="Webs reales, funcionando hoy." intro="No son maquetas: puedes entrar ahora mismo desde tu móvil." /><div class="project-list">{projects.map((project) => <ProjectCard project={project} />)}</div><div style="margin-top:4rem"><a class="button button--ghost" href="/proyectos">Ver todos los proyectos <span>→</span></a></div></div></section>

  <section class="section" id="precios"><div class="container"><SectionHeading number="03" title="Lo que cuesta, sin letra pequeña." /><PricingCards /></div></section>

  <section class="section section--dark"><div class="container"><SectionHeading number="04" title="Primero lo ves. Después decides." intro="No pagas nada hasta que hayas visto tu demo y te guste." /><div class="process-board" data-reveal>{steps.map((step, index) => <article class="process-note"><span class="status">{index < 2 ? 'gratis' : 'siguiente'}</span><b>0{index + 1}</b><h3>{step[0]}</h3><p>{step[1]}</p></article>)}</div></div></section>

  <section class="section"><div class="narrow"><SectionHeading number="FAQ" title="Lo que nos suelen preguntar." /><Accordion items={faq} /></div></section>

  <section class="section section--tight"><div class="container idea-box" data-reveal><div><span class="eyebrow">Tu turno</span><h2 class="section-title">¿Qué necesita tu negocio?</h2><p class="typed-line"><span data-typed aria-hidden="true">Una carta online para mi pizzería.</span><span class="typed-cursor" aria-hidden="true"></span><span class="sr-only">Por ejemplo: una carta online para una pizzería, una web para una casa rural o recibir pedidos por WhatsApp.</span></p><p>Escríbenos y te preparamos una demo gratis.</p><a class="button" href={site.whatsapp} target="_blank" rel="noopener noreferrer">Pedir mi demo por WhatsApp <span>↗</span></a></div></div></section>

  <section class="section"><div class="container case-copy-grid" data-reveal><div><span class="eyebrow">El estudio</span><h2 class="section-title">Cerca, aunque trabajemos en remoto.</h2></div><div><p class="lead">Somos un estudio independiente de diseño y desarrollo. Hablas directamente con quienes hacen tu web, por WhatsApp o videollamada, estés donde estés de España.</p><a class="arrow-link" href="/nosotros">Conocer el estudio <span>→</span></a></div></div></section>
  <ContactBlock />
  <script>
    const setupTyping = () => {
      const el = document.querySelector<HTMLElement>('[data-typed]'); if (!el || el.dataset.ready) return; el.dataset.ready = 'true';
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const phrases = ['Una carta online para mi pizzería.', 'Una web para mi casa rural.', 'Recibir pedidos por WhatsApp.'];
      let p = 0, i = phrases[0].length, deleting = true;
      const type = () => { const phrase = phrases[p]; i += deleting ? -1 : 1; el.textContent = phrase.slice(0, i); if (i <= 0) { deleting = false; p = (p + 1) % phrases.length; } if (i >= phrases[p].length && !deleting) { deleting = true; setTimeout(type, 1800); return; } setTimeout(type, deleting ? 42 : 72); };
      setTimeout(type, 1700);
    };
    setupTyping(); document.addEventListener('astro:page-load', setupTyping);
  </script>
</BaseLayout>
