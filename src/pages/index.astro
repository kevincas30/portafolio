---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BrowserFrame from '../components/BrowserFrame.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProcessBoard from '../components/ProcessBoard.astro';
import Accordion from '../components/Accordion.astro';
import ContactBlock from '../components/ContactBlock.astro';
import ReadingWords from '../components/ReadingWords.astro';
import HeroColorBends from '../components/hero/HeroColorBends';
import { site, waLink, redesWhatsAppText } from '../config/site';
const projects = (await getCollection('projects')).filter((p) => p.data.featured).sort((a,b) => (a.data.homeOrder ?? 0) - (b.data.homeOrder ?? 0));
const steps = [
  ['Nos cuentas qué necesitas.', 'Cuéntanos qué negocio tienes y pásanos lo que tengas: una web actual, fotos o un catálogo.', 'Hablemos'],
  ['Preparamos una muestra visual.', 'Te enseñamos un enfoque inicial para tu web antes de contratar; todavía no es la web completa.', 'Tu demo gratis'],
  ['Si te gusta, empezamos.', 'Acordamos el trabajo y pagas el 50% al empezar. Si falta material, te ayudamos a prepararlo.', 'Empezamos'],
  ['Revisamos contigo.', 'Ajustamos textos, fotos y detalles hasta que esté como quieres.', 'Afinamos juntos'],
  ['La publicamos.', 'Pagas el 50% restante y tu web queda online con tu propio dominio.', 'Tu web online'],
];
const faq = [
  { question: '¿Sirve para cualquier tipo de negocio?', answer: 'Sí. Adaptamos el alcance a lo que necesites: un restaurante, un hotel, una tienda online o un negocio de servicios.' },
  { question: '¿Puedo hacer cambios yo mismo?', answer: 'Según el proyecto, dejamos editable lo que más cambia (precios, productos, horarios) desde una hoja de cálculo o un panel sencillo. La cuota mensual incluye cambios pequeños.' },
  { question: '¿Qué incluyen los 15 € al mes?', answer: `${site.monthlyIncludes}` },
  { question: '¿Cuánto tarda?', answer: 'Depende del alcance del proyecto; te damos un plazo concreto en el presupuesto.' },
  { question: '¿Qué es la demo gratis?', answer: 'Una muestra visual inicial del enfoque para tu web. No es una web completa terminada y no te compromete a contratar.' },
  { question: '¿Cómo se paga?', answer: 'El 50 % al empezar y el 50 % al publicar, por Bizum o transferencia.' },
  { question: '¿No tengo fotos ni textos, puedo igual?', answer: 'Sí. Te ayudamos a escribir los textos y a elegir las fotos. Con las de tu móvil, bien hechas, suele ser suficiente para empezar.' },
  { question: '¿Trabajáis fuera de mi ciudad?', answer: 'Sí. Trabajamos en remoto con negocios de cualquier lugar, por WhatsApp o videollamada.' },
];
---
<BaseLayout title="Diseño Creativo" description={site.description}>
  <section class="hero" data-hero-motion>
    <HeroColorBends client:visible />
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1 class="display"><span><span class="hero-title-motion">Tu negocio merece</span></span> <span><span class="hero-title-motion">una web que invite</span></span> <span><span class="hero-title-motion">a elegirlo.</span></span></h1>
        <p class="lead">Diseñamos y desarrollamos páginas web a medida: la carta de un <strong>restaurante</strong>, las habitaciones de un <strong>hotel</strong>, una <strong>tienda online</strong> o la web de cualquier negocio que necesite presentarse bien.</p>
        <div class="button-row"><a class="button hero-demo" href={site.whatsapp} target="_blank" rel="noopener noreferrer"><span class="hero-demo-label">Pedir mi demo gratis</span> <span class="hero-demo-arrow" aria-hidden="true">↗</span></a><a class="arrow-link hero-project-link" href="/proyectos">Ver proyectos reales <span aria-hidden="true">→</span></a></div>
        <p class="hero-support">Una muestra de cómo podría quedar tu web, sin compromiso.</p>
        <p class="hero-meta">{site.area}</p>
      </div>
      <div class="desk-composition" data-hero-composition aria-label="Webs reales: Alojamiento La Rueca en escritorio e Italy Pizza en el móvil">
        <div class="hero-entry"><div class="hero-float"><div class="hero-highlight hero-highlight--browser"><BrowserFrame class="hero-browser" src="/proyectos/La%20rueca/la-rueca-desktop.webp" alt="Web de Alojamiento La Rueca en escritorio" /></div></div></div>
        <div class="hero-entry"><div class="hero-float"><div class="hero-highlight hero-highlight--phone"><PhoneFrame class="hero-phone" src="/proyectos/Italy%20pizza/italy-pizza-mobile.webp" alt="Carta online de Italy Pizza en el móvil" /></div></div></div>
        <div class="hero-entry"><div class="hero-float"><div class="hero-note">proyectos reales,<br/>publicados online ↘</div></div></div>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="narrow" data-scroll-reading><h2 class="intro-statement"><ReadingWords text="Antes de llamar o reservar, " /><em><ReadingWords text="quieren conocerte." /></em></h2><p class="lead">Qué ofreces, cómo es tu espacio, dónde estás y cómo contactar. Una web propia reúne esa información y facilita el siguiente paso.</p><p>No cobramos comisión por los pedidos o consultas que recibas desde tu web.</p></div>
  </section>

  <section class="section home-projects"><div class="container"><SectionHeading number="01" title="Webs reales, hechas para cada negocio." intro="Cuatro proyectos distintos: un negocio de servicios, un restaurante, una tienda online y un hotel." /><div class="project-list">{projects.map((project) => <ProjectCard project={project} showVideoPreview />)}</div><div style="margin-top:4rem"><a class="button button--ghost" href="/proyectos">Ver todos los proyectos <span>→</span></a></div></div></section>

  <section class="section home-packs"><div class="container packs-workspace">
    <SectionHeading number="02" title="Dos formas de ayudarte a venderte mejor." typewriter intro="Una web que presente tu negocio, y contenido para que te reconozcan en redes." />
    <div class="services-split">
      <article class="service-panel">
        <div class="service-copy"><div><span class="label">Diseño y desarrollo web</span><h3>Tu negocio, con una web a su altura</h3><p>Diseñamos y desarrollamos páginas web para cualquier tipo de negocio: restaurantes, hoteles, tiendas online o servicios locales.</p></div><div class="button-row"><a class="button button--lime" href={waLink()} target="_blank" rel="noopener noreferrer">Quiero mi demo <span>↗</span></a><a class="arrow-link" href="/servicios">Ver servicios <span>→</span></a></div></div>
        <div class="service-visual"><div class="pack-float" data-pack-float><div class="pack-tilt" data-pack-tilt><BrowserFrame src="/proyectos/Italy%20pizza/italy-pizza-desktop.webp" alt="Web de Italy Pizza en escritorio" /></div></div></div>
      </article>
      <article class="service-panel">
        <div class="service-copy"><div><span class="label">Diseño para redes</span><h3>Contenido que se reconozca como tuyo</h3><p>Posts, historias, carruseles y reels pensados para que tu marca tenga una presencia coherente.</p></div><div class="button-row"><a class="button button--lime" href={waLink(redesWhatsAppText)} target="_blank" rel="noopener noreferrer">Pedir presupuesto <span>↗</span></a><a class="arrow-link" href="/servicios/diseno-para-redes">Ver diseño para redes <span>→</span></a></div></div>
        <div class="service-visual"><div class="pack-float" data-pack-float><div class="pack-tilt" data-pack-tilt><PhoneFrame class="service-phone" alt="Reel de contenido para redes sociales" video={{ src: '/redes/reels/reel-06.mp4', poster: '/redes/reels/reel-06-poster.jpg' }} /></div></div></div>
      </article>
    </div>
    </div>
  </section>

  <section class="section section--dark home-closing-section"><div class="container"><SectionHeading number="03" title="Primero lo ves. Después decides." intro="La demo gratuita es una muestra visual inicial para valorar el enfoque antes de contratar." /><ProcessBoard steps={steps} /></div></section>

  <section class="section home-closing-section"><div class="narrow"><SectionHeading number="FAQ" title="Lo que nos suelen preguntar." /><Accordion items={faq} /></div></section>

  <section class="section section--tight home-closing-section"><div class="container idea-box" data-reveal><div><span class="eyebrow">Tu turno</span><h2 class="section-title">¿Qué necesita tu negocio?</h2><p class="typed-line"><span data-typed aria-hidden="true">Mostrar mi restaurante y su carta.</span><span class="typed-cursor" aria-hidden="true"></span><span class="sr-only">Por ejemplo: mostrar un restaurante y su carta, presentar las habitaciones de un hotel, vender en una tienda online o mostrar un negocio de servicios.</span></p><p>Cuéntanos tu idea y te mostramos una propuesta visual inicial.</p><a class="button" href={site.whatsapp} target="_blank" rel="noopener noreferrer">Pedir mi demo <span aria-hidden="true">↗</span></a></div></div></section>

  <section class="section home-closing-section"><div class="container case-copy-grid" data-reveal><div><span class="eyebrow">El estudio</span><h2 class="section-title">Cerca, aunque trabajemos en remoto.</h2></div><div><p class="lead">Somos un estudio independiente de diseño y desarrollo. Hablas directamente con quienes hacen tu web, por WhatsApp o videollamada. Trabajamos con negocios de cualquier lugar.</p><a class="arrow-link" href="/nosotros">Conocer el estudio <span>→</span></a></div></div></section>
  <ContactBlock class="home-closing-section" home />
  <script>
    const setupTyping = () => {
      const el = document.querySelector<HTMLElement>('[data-typed]'); if (!el || el.dataset.ready) return; el.dataset.ready = 'true';
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const phrases = ['Mostrar mi restaurante y su carta.', 'Presentar las habitaciones de mi hotel.', 'Vender en mi tienda online.', 'Mostrar mis servicios de jardinería.'];
      let p = 0, i = phrases[0].length, deleting = true;
      const type = () => { const phrase = phrases[p]; i += deleting ? -1 : 1; el.textContent = phrase.slice(0, i); if (i <= 0) { deleting = false; p = (p + 1) % phrases.length; } if (i >= phrases[p].length && !deleting) { deleting = true; setTimeout(type, 1800); return; } setTimeout(type, deleting ? 42 : 72); };
      setTimeout(type, 1700);
    };
    setupTyping(); document.addEventListener('astro:page-load', setupTyping);
  </script>
</BaseLayout>
