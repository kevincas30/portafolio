---
import { site, waLink, launchPrice } from '../config/site';
const offer = site.launchOffer;
---
<div class="pricing" data-reveal>
  {offer.enabled && (
    <p class="pricing-offer"><b>Precio de lanzamiento:</b> {offer.discount}% de descuento para los {offer.slots} primeros negocios.</p>
  )}
  <div class="pricing-grid">
    {site.packs.map((pack) => (
      <article class="price-card">
        <svg class="price-edge" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
          <rect x="6" y="6" />
        </svg>
        <span class="label">{pack.label}</span>
        <h3>{pack.title}</h3>
        <p class="price-pitch">{pack.pitch}</p>
        <p class="price-group-label">Funciones incluidas</p>
        <ul class="price-list">{pack.includes.map((item) => <li>{item}</li>)}</ul>
        <p class="price-delivery">{pack.delivery}, desde que tenemos tu material.</p>
        <div class="price-amount">
          <div class="price-part"><span>Pago por creación</span>{offer.enabled ? <><s aria-label={`Antes ${pack.price} euros`}>{pack.price} €</s><strong>{launchPrice(pack.price)} €</strong></> : <strong>{pack.price} €</strong>}</div>
          <div class="price-part"><span>Cuota mensual</span><strong>{pack.monthly} €/mes</strong></div>
        </div>
        {pack.extra && <div class="price-extra"><b>Incluido y presupuestado aparte</b><p>{pack.extra}</p></div>}
        <div class="button-row">
          <a class="button button--lime price-demo" href={waLink(pack.waText)} target="_blank" rel="noopener noreferrer">Pedir demo gratis <span aria-hidden="true">↗</span></a>
          <a class="arrow-link" href={pack.href}>Ver detalles <span aria-hidden="true">→</span></a>
        </div>
      </article>
    ))}
  </div>
  <p class="pricing-note"><b>La cuota mensual incluye:</b> {site.monthlyIncludes} El pago por creación se divide en 50 % al empezar y 50 % al publicar, por Bizum o transferencia. La demo gratuita es una muestra visual inicial, no una web completa.</p>
</div>

<script>
  // CSS draws the light; this observer only pauses cards outside the viewport.
  let cleanupPriceEdges: (() => void) | undefined;
  const edgeMotionPreference = matchMedia('(prefers-reduced-motion: reduce)');

  const initPriceEdges = () => {
    cleanupPriceEdges?.();
    cleanupPriceEdges = undefined;
    const cards = [...document.querySelectorAll<HTMLElement>('.price-card')];
    if (!cards.length || edgeMotionPreference.matches || !('IntersectionObserver' in window)) return;

    const visible = new Set<HTMLElement>();
    const update = () => cards.forEach((card) => {
      card.dataset.edgeActive = String(visible.has(card) && !document.hidden);
    });
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const card = entry.target as HTMLElement;
        if (entry.isIntersecting) visible.add(card);
        else visible.delete(card);
      });
      update();
    });
    cards.forEach((card) => observer.observe(card));
    document.addEventListener('visibilitychange', update);
    cleanupPriceEdges = () => {
      observer.disconnect();
      document.removeEventListener('visibilitychange', update);
      cards.forEach((card) => card.removeAttribute('data-edge-active'));
      visible.clear();
    };
  };

  document.addEventListener('astro:page-load', initPriceEdges);
  document.addEventListener('astro:before-preparation', () => {
    cleanupPriceEdges?.();
    cleanupPriceEdges = undefined;
  });
  edgeMotionPreference.addEventListener('change', initPriceEdges);
</script>
