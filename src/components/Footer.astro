---
import { site } from '../config/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-mark">Diseño<br/>Creativo.</div>
      <nav class="footer-links" aria-label="Navegación del pie">
        <b>Explorar</b>
        {site.navigation.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href="/servicios/diseno-para-redes">Diseño para redes</a>
        <a href="/nosotros">Nosotros</a>
      </nav>
      <div class="footer-links">
        <b>Hablemos</b>
        {site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}
        {site.whatsapp && <a href={site.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp {site.whatsappDisplay}</a>}
        {site.socials.map((social) => <a href={social.url} rel="noreferrer">{social.label}</a>)}
        {!site.email && !site.whatsapp && <a href="/contacto">Formulario de contacto →</a>}
        <span>{site.area}</span>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {year} Diseño Creativo</span>
      <span><a href="/aviso-legal">Aviso legal</a> · <a href="/privacidad">Privacidad</a></span>
      <span>Diseñado con intención</span>
    </div>
  </div>
</footer>
