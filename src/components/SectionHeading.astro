---
interface Props { number?: string; title: string; intro?: string; typewriter?: boolean; reveal?: boolean; }
const { title, intro, typewriter = false, reveal = true } = Astro.props;
---
<header class="section-head" data-reveal={reveal ? '' : undefined}>
  <div>
    {typewriter ? (
      <h2 class="section-title" data-typewriter-title aria-label={title}>
        <span aria-hidden="true">{title.split(/(\s+)/).map((part) => /^\s+$/.test(part) ? part : (
          <span class="typewriter-word">{Array.from(part).map((character) => <span data-typewriter-char>{character}</span>)}</span>
        ))}</span>
      </h2>
    ) : <h2 class="section-title">{title}</h2>}
    {intro && <p class="lead">{intro}</p>}
  </div>
</header>
