---
import ContactForm from './ContactForm.astro';
import { site } from '../config/site';

interface Props {
  compact?: boolean;
  class?: string;
  home?: boolean;
}

const { compact = true, class: className, home = false } = Astro.props;
---
<section class:list={["section", className]}>
  <div class:list={["container", "contact-card", home && "contact-card--home"]} data-reveal>
    <div>
      <span class="eyebrow">Hablemos</span>
      {home
        ? <h2><span class="contact-title-line">Te preparamos</span> <span class="contact-title-line">una demo</span> <span class="contact-title-line">gratis.</span></h2>
        : <h2>Te preparamos una demo gratis.</h2>}
      <p>{home
        ? 'Cuéntanos qué negocio tienes y qué necesitas. Te preparamos una muestra para que veas cómo podría quedar tu web.'
        : 'Escríbenos por WhatsApp con el nombre de tu negocio. Te enseñamos cómo quedaría tu web antes de que pagues nada.'}</p>
    </div>
    <div class="contact-actions">
      <a class:list={["button", home && "contact-primary"]} href={site.whatsapp} target="_blank" rel="noopener noreferrer">Escribir por WhatsApp <span aria-hidden="true">↗</span></a>
      <a class:list={["arrow-link", home && "contact-email"]} href={`mailto:${site.email}`}>{site.email} <span aria-hidden="true">↗</span></a>
      {home
        ? <p class="contact-hint contact-hint--stacked"><span>{site.whatsappDisplay}</span><span>Te respondemos en menos de 48 h.</span></p>
        : <p class="contact-hint">{site.whatsappDisplay} · Te respondemos en menos de 48 h.</p>}
      {site.form.enabled && <ContactForm compact={compact} />}
    </div>
  </div>
</section>
