---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { site } from '../config/site';
import '../styles/global.css';

interface Props { title: string; description?: string; image?: string; noindex?: boolean; }
const { title, description = site.description, image = '/proyectos/Italy%20pizza/italy-pizza-desktop.webp', noindex = false } = Astro.props;
const pageTitle = title === site.name ? title : `${title} — ${site.name}`;
const canonical = site.url ? new URL(Astro.url.pathname, site.url).toString() : undefined;
const ogImage = site.url ? new URL(image, site.url).toString() : image;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta id="theme-color" name="theme-color" content="#f3f1eb" />
    <script is:inline>
      (() => {
        let theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        try {
          const saved = localStorage.getItem('dc-theme');
          if (saved === 'light' || saved === 'dark') theme = saved;
        } catch {}
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
    <link rel="icon" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <div class="decor-bg" aria-hidden="true"><div class="noise"></div></div>
    <Header />
    <main id="contenido"><slot /></main>
    <Footer />
    <WhatsAppFloat />
    <script>
      import gsap from 'gsap';
      import ScrollTrigger from 'gsap/ScrollTrigger';
      import Lenis from 'lenis';
      import 'lenis/dist/lenis.css';
      import { setupHeroMotion } from '../scripts/hero-motion';
      import { setupReadingMotion } from '../scripts/reading-motion';
      import { setupTypewriterTitle } from '../scripts/typewriter-title';
      import { setupPackFloating } from '../scripts/pack-floating';
      import { setupProcessTimeline } from '../scripts/process-timeline';
      import { setupProjectGalleryReveal } from '../scripts/project-gallery-reveal';
      import { setupProjectCaseMotion } from '../scripts/project-case-motion';

      let context: gsap.Context | undefined;
      let lenis: Lenis | undefined;
      let removeTicker: (() => void) | undefined;
      let removeHeroMotion: (() => void) | undefined;
      let removeReadingMotion: (() => void) | undefined;
      let removeTypewriterTitle: (() => void) | undefined;
      let removePackFloating: (() => void) | undefined;
      let removeProcessTimeline: (() => void) | undefined;
      let removeProjectGalleryReveal: (() => void) | undefined;
      let removeProjectCaseMotion: (() => void) | undefined;
      const motionPreference = matchMedia('(prefers-reduced-motion: reduce)');

      const cleanup = () => {
        removeHeroMotion?.(); removeHeroMotion = undefined;
        removeReadingMotion?.(); removeReadingMotion = undefined;
        removeTypewriterTitle?.(); removeTypewriterTitle = undefined;
        removePackFloating?.(); removePackFloating = undefined;
        removeProcessTimeline?.(); removeProcessTimeline = undefined;
        removeProjectGalleryReveal?.(); removeProjectGalleryReveal = undefined;
        removeProjectCaseMotion?.(); removeProjectCaseMotion = undefined;
        context?.revert(); context = undefined;
        lenis?.destroy(); lenis = undefined;
        removeTicker?.(); removeTicker = undefined;
      };

      const init = () => {
        cleanup();
        const reduced = motionPreference.matches;
        gsap.registerPlugin(ScrollTrigger);
        if (!reduced && matchMedia('(pointer: fine)').matches) {
          lenis = new Lenis({ duration: 1.05, smoothWheel: true, anchors: true });
          lenis.on('scroll', ScrollTrigger.update);
          const tick = (time: number) => lenis?.raf(time * 1000);
          gsap.ticker.add(tick); gsap.ticker.lagSmoothing(0);
          removeTicker = () => gsap.ticker.remove(tick);
        }
        if (reduced) { document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => { el.style.opacity = '1'; el.style.transform = 'none'; }); return; }
        context = gsap.context(() => {
          const copy = gsap.utils.toArray<HTMLElement>('.hero-copy > *').filter((element) => !element.closest('[data-hero-motion]'));
          if (copy.length) gsap.from(copy, { opacity: 0, y: 22, duration: .8, stagger: .09, ease: 'power3.out' });
          const compositions = document.querySelectorAll('.desk-composition:not([data-hero-composition]) > *');
          if (compositions.length) gsap.from(compositions, { opacity: 0, scale: .96, y: 25, duration: .9, stagger: .1, ease: 'power3.out', delay: .2 });
          document.querySelectorAll('[data-reveal]').forEach((element) => gsap.to(element, { opacity: 1, y: 0, duration: .8, ease: 'power3.out', scrollTrigger: { trigger: element, start: 'top 88%', once: true } }));
          document.querySelectorAll<HTMLElement>('[data-parallax]').forEach((element) => gsap.to(element, { yPercent: -5, ease: 'none', scrollTrigger: { trigger: element, start: 'top bottom', end: 'bottom top', scrub: .6 } }));
        });
        const hero = document.querySelector<HTMLElement>('[data-hero-motion]');
        if (hero) removeHeroMotion = setupHeroMotion(hero);
        const reading = document.querySelector<HTMLElement>('[data-scroll-reading]');
        if (reading) removeReadingMotion = setupReadingMotion(reading);
        const typewriter = document.querySelector<HTMLElement>('[data-typewriter-title]');
        if (typewriter) removeTypewriterTitle = setupTypewriterTitle(typewriter);
        const packs = document.querySelector<HTMLElement>('.home-packs');
        if (packs) removePackFloating = setupPackFloating(packs);
        const processTimeline = document.querySelector<HTMLElement>('[data-process-timeline]');
        if (processTimeline) removeProcessTimeline = setupProcessTimeline(processTimeline);
        const projectGallery = document.querySelector<HTMLElement>('[data-project-gallery-reveal]');
        if (projectGallery) removeProjectGalleryReveal = setupProjectGalleryReveal(projectGallery);
        const projectCase = document.querySelector<HTMLElement>('.project-case');
        if (projectCase) removeProjectCaseMotion = setupProjectCaseMotion(projectCase);
        ScrollTrigger.refresh();
      };
      document.addEventListener('astro:before-preparation', cleanup);
      document.addEventListener('astro:page-load', init);
      motionPreference.addEventListener('change', init);
    </script>
  </body>
</html>
